<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Student Registration | The Ravishankar Insights</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: linear-gradient(135deg, #07111f, #123b5d, #081b2d);
    }

    .register-box {
      width: 100%;
      max-width: 430px;
      background: white;
      padding: 28px;
      border-radius: 22px;
      box-shadow: 0 15px 45px rgba(0,0,0,.4);
    }

    .logo {
      text-align: center;
      font-size: 26px;
      font-weight: bold;
      color: #123b5d;
      margin-bottom: 7px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 24px;
    }

    .input-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
      color: #333;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 10px;
      outline: none;
      font-size: 15px;
    }

    input:focus {
      border-color: #1677ff;
    }

    .otp-row {
      display: flex;
      gap: 8px;
    }

    .otp-row input {
      flex: 1;
    }

    .otp-btn {
      border: none;
      border-radius: 10px;
      padding: 0 12px;
      background: #123b5d;
      color: white;
      font-weight: bold;
    }

    .register-btn {
      width: 100%;
      padding: 14px;
      margin-top: 8px;
      border: none;
      border-radius: 11px;
      background: linear-gradient(135deg,#1677ff,#095dcc);
      color: white;
      font-size: 17px;
      font-weight: bold;
    }

    .login-link {
      text-align: center;
      margin-top: 18px;
      color: #666;
    }

    .login-link a {
      color: #1677ff;
      font-weight: bold;
      text-decoration: none;
    }

    #message {
      text-align: center;
      margin-top: 13px;
      font-weight: bold;
    }

    .note {
      text-align: center;
      margin-top: 15px;
      color: #888;
      font-size: 12px;
    }
  </style>
</head>

<body>

<div class="register-box">

  <div class="logo">The Ravishankar Insights</div>

  <div class="subtitle">
    Student Registration
  </div>

  <form id="registerForm">

    <div class="input-group">
      <label>Full Name</label>
      <input
        type="text"
        id="name"
        placeholder="अपना नाम लिखें"
        required
      >
    </div>

    <div class="input-group">
      <label>Phone Number</label>
      <input
        type="tel"
        id="phone"
        placeholder="10 digit mobile number"
        maxlength="10"
        required
      >
    </div>

    <div class="input-group">
      <label>Email</label>
      <input
        type="email"
        id="email"
        placeholder="example@gmail.com"
        required
      >
    </div>

    <div class="input-group">
      <label>OTP</label>

      <div class="otp-row">
        <input
          type="text"
          id="otp"
          placeholder="123456"
          maxlength="6"
          required
        >

        <button
          type="button"
          class="otp-btn"
          id="sendOtp"
        >
          Send OTP
        </button>
      </div>
    </div>

    <div class="input-group">
      <label>Password</label>

      <input
        type="password"
        id="password"
        placeholder="Password बनाएं"
        minlength="6"
        required
      >
    </div>

    <div class="input-group">
      <label>Confirm Password</label>

      <input
        type="password"
        id="confirmPassword"
        placeholder="Password दोबारा लिखें"
        minlength="6"
        required
      >
    </div>

    <button
      type="submit"
      class="register-btn"
    >
      Register
    </button>

    <div id="message"></div>

  </form>

  <div class="login-link">
    पहले से account है?
    <a href="login.html">Login करें</a>
  </div>

  <div class="note">
    🔒 Student materials login के बाद access होंगे।
  </div>

</div>

<script>

const form = document.getElementById("registerForm");
const message = document.getElementById("message");

document.getElementById("sendOtp").addEventListener("click", function() {

  message.style.color = "green";
  message.textContent =
    "Testing OTP: 123456 डालें।";

});


form.addEventListener("submit", async function(event) {

  event.preventDefault();

  const name =
    document.getElementById("name").value.trim();

  const phone =
    document.getElementById("phone").value.trim();

  const email =
    document.getElementById("email").value.trim();

  const otp =
    document.getElementById("otp").value.trim();

  const password =
    document.getElementById("password").value;

  const confirmPassword =
    document.getElementById("confirmPassword").value;


  if (otp !== "123456") {

    message.style.color = "red";
    message.textContent =
      "Testing के लिए OTP 123456 डालें।";

    return;
  }


  if (password !== confirmPassword) {

    message.style.color = "red";
    message.textContent =
      "Password match नहीं कर रहा है।";

    return;
  }


  message.style.color = "#1677ff";
  message.textContent =
    "Registration हो रहा है...";


  try {

    const response = await fetch(
      "https://ravishankar-insights-backend-1.onrender.com/api/register",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          name: name,
          phone: phone,
          email: email,
          password: password
        })
      }
    );


    const data = await response.json();


    if (response.ok) {

      message.style.color = "green";

      message.textContent =
        "Registration सफल हुआ! Login करें।";


      setTimeout(function() {

        window.location.href = "login.html";

      }, 1500);


    } else {

      message.style.color = "red";

      message.textContent =
        data.message || "Registration failed.";

    }


  } catch (error) {

    console.log(error);

    message.style.color = "red";

    message.textContent =
      "अभी सेवा उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर प्रयास करें।";

  }

});

</script>

</body>
</html>
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Student Registration | The Ravishankar Insights</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: linear-gradient(135deg, #07111f, #123b5d, #081b2d);
    }

    .register-box {
      width: 100%;
      max-width: 430px;
      background: white;
      padding: 28px;
      border-radius: 22px;
      box-shadow: 0 15px 45px rgba(0,0,0,.4);
    }

    .logo {
      text-align: center;
      font-size: 26px;
      font-weight: bold;
      color: #123b5d;
      margin-bottom: 7px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 24px;
    }

    .input-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
      color: #333;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 10px;
      outline: none;
      font-size: 15px;
    }

    input:focus {
      border-color: #1677ff;
    }

    .otp-row {
      display: flex;
      gap: 8px;
    }

    .otp-row input {
      flex: 1;
    }

    .otp-btn {
      border: none;
      border-radius: 10px;
      padding: 0 12px;
      background: #123b5d;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .otp-btn:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .register-btn {
      width: 100%;
      padding: 14px;
      margin-top: 8px;
      border: none;
      border-radius: 11px;
      background: linear-gradient(135deg,#1677ff,#095dcc);
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    .login-link {
      text-align: center;
      margin-top: 18px;
      color: #666;
    }

    .login-link a {
      color: #1677ff;
      font-weight: bold;
      text-decoration: none;
    }

    #message {
      text-align: center;
      margin-top: 13px;
      font-weight: bold;
    }

    .note {
      text-align: center;
      margin-top: 15px;
      color: #888;
      font-size: 12px;
    }
  </style>
</head>

<body>

<div class="register-box">

  <div class="logo">The Ravishankar Insights</div>

  <div class="subtitle">
    Student Registration
  </div>

  <form id="registerForm">

    <div class="input-group">
      <label>Full Name</label>
      <input
        type="text"
        id="name"
        placeholder="अपना नाम लिखें"
        required
      >
    </div>

    <div class="input-group">
      <label>Phone Number</label>
      <input
        type="tel"
        id="phone"
        placeholder="10 digit mobile number"
        maxlength="10"
        inputmode="numeric"
        required
      >
    </div>

    <div class="input-group">
      <label>Email</label>
      <input
        type="email"
        id="email"
        placeholder="example@gmail.com"
        required
      >
    </div>

    <div class="input-group">
      <label>OTP</label>

      <div class="otp-row">

        <input
          type="text"
          id="otp"
          placeholder="SMS से आया OTP"
          maxlength="6"
          inputmode="numeric"
          required
        >

        <button
          type="button"
          class="otp-btn"
          id="sendOtp"
        >
          Send OTP
        </button>

      </div>
    </div>

    <div class="input-group">
      <label>Password</label>

      <input
        type="password"
        id="password"
        placeholder="Password बनाएं"
        minlength="6"
        required
      >
    </div>

    <div class="input-group">
      <label>Confirm Password</label>

      <input
        type="password"
        id="confirmPassword"
        placeholder="Password दोबारा लिखें"
        minlength="6"
        required
      >
    </div>

    <button
      type="submit"
      class="register-btn"
    >
      Verify OTP & Register
    </button>

    <div id="message"></div>

  </form>

  <div class="login-link">
    पहले से account है?
    <a href="login.html">Login करें</a>
  </div>

  <div class="note">
    🔒 Student materials login के बाद access होंगे।
  </div>

</div>


<script>

const API =
  "https://ravishankar-insights-backend-1.onrender.com";

const form =
  document.getElementById("registerForm");

const message =
  document.getElementById("message");

const sendOtpBtn =
  document.getElementById("sendOtp");


function showMessage(text, color) {

  message.textContent = text;
  message.style.color = color;

}


// ==============================
// SEND REAL SMS OTP
// ==============================

sendOtpBtn.addEventListener(
  "click",
  async function() {

    const name =
      document.getElementById("name")
        .value.trim();

    const phone =
      document.getElementById("phone")
        .value.trim();

    const email =
      document.getElementById("email")
        .value.trim();

    const password =
      document.getElementById("password")
        .value;

    const confirmPassword =
      document.getElementById("confirmPassword")
        .value;


    if (!name) {

      showMessage(
        "पहले अपना नाम डालें।",
        "red"
      );

      return;
    }


    if (!/^[0-9]{10}$/.test(phone)) {

      showMessage(
        "सही 10 digit mobile number डालें।",
        "red"
      );

      return;
    }


    if (!email) {

      showMessage(
        "Email डालें।",
        "red"
      );

      return;
    }


    if (password.length < 6) {

      showMessage(
        "Password कम से कम 6 characters का होना चाहिए।",
        "red"
      );

      return;
    }


    if (password !== confirmPassword) {

      showMessage(
        "Password match नहीं कर रहा है।",
        "red"
      );

      return;
    }


    sendOtpBtn.disabled = true;

    sendOtpBtn.textContent =
      "Sending...";


    showMessage(
      "OTP SMS भेजा जा रहा है...",
      "#1677ff"
    );


    try {

      const response =
        await fetch(
          API + "/api/student/send-otp",
          {

            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({

              name: name,

              mobile: phone,

              email: email,

              password: password

            })

          }
        );


      const data =
        await response.json();


      if (!response.ok ||
          !data.success) {

        showMessage(
          data.message ||
          "OTP भेजने में समस्या हुई।",
          "red"
        );

        sendOtpBtn.disabled = false;

        sendOtpBtn.textContent =
          "Send OTP";

        return;
      }


      showMessage(
        "✅ OTP SMS भेज दिया गया है। अपना SMS check करें।",
        "green"
      );


      sendOtpBtn.textContent =
        "OTP Sent";


    } catch (error) {

      console.error(error);

      showMessage(
        "❌ अभी सेवा उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर प्रयास करें।",
        "red"
      );

      sendOtpBtn.disabled = false;

      sendOtpBtn.textContent =
        "Send OTP";
    }

  }
);


// ==============================
// VERIFY OTP + REGISTER
// ==============================

form.addEventListener(
  "submit",
  async function(event) {

    event.preventDefault();


    const name =
      document.getElementById("name")
        .value.trim();

    const phone =
      document.getElementById("phone")
        .value.trim();

    const email =
      document.getElementById("email")
        .value.trim();

    const otp =
      document.getElementById("otp")
        .value.trim();

    const password =
      document.getElementById("password")
        .value;

    const confirmPassword =
      document.getElementById("confirmPassword")
        .value;


    if (!/^[0-9]{6}$/.test(otp)) {

      showMessage(
        "SMS से आया 6 digit OTP डालें।",
        "red"
      );

      return;
    }


    if (password !== confirmPassword) {

      showMessage(
        "Password match नहीं कर रहा है।",
        "red"
      );

      return;
    }


    showMessage(
      "OTP verify हो रहा है...",
      "#1677ff"
    );


    try {

      const response =
        await fetch(
          API + "/api/student/verify-otp",
          {

            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({

              name: name,

              mobile: phone,

              email: email,

              password: password,

              otp: otp

            })

          }
        );


      const data =
        await response.json();


      if (!response.ok ||
          !data.success) {

        showMessage(
          data.message ||
          "OTP verification failed.",
          "red"
        );

        return;
      }


      showMessage(
        "✅ Registration सफल हुआ! Login करें।",
        "green"
      );


      setTimeout(
        function() {

          window.location.href =
            "login.html";

        },
        1200
      );


    } catch (error) {

      console.error(error);

      showMessage(
        "❌ अभी सेवा उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर प्रयास करें।",
        "red"
      );

    }

  }
);

</script>

</body>
</html>
